# Groq Cloud (LLaMA Vision + Text LLM)
GROQ_API_KEY=your_groq_api_key_here
LLAMA_MODEL=llama-3.2-11b-vision-preview
LLAMA_TIMEOUT_SECONDS=30

# Optional: Together AI / HuggingFace Inference fallbacks
TOGETHER_API_KEY=your_together_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Pollinations / Flux image generation
POLLINATIONS_API_KEY=your_pollinations_api_key_here
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# App
APP_NAME=Multimodal Construction Intelligence Platform
